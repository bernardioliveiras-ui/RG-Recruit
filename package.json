{
  "name": "rg-recruit",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "devDependencies": { "wrangler": "^4.36.0" },
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev --ip 127.0.0.1",
